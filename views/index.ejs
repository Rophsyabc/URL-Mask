<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SearchEngine</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="home-container">
        <!-- ── Brand name: replace "SearchEngine" with your client's name ── -->
        <div class="brand-logo">SoarDevEngine</div>

        <form action="/search" method="GET" class="search-form">
            <div class="search-box-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="#9aa0a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    style="flex-shrink:0;">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" name="q" class="search-input" placeholder="Search the web..." autocomplete="off"
                    autofocus required>
            </div>
            <div class="search-btn">
                <button type="submit">Search</button>
            </div>
        </form>
    </div>
</body>

</html>